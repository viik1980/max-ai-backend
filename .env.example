# === Обязательно ===
# Ключ Gemini API. Получить: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Сервис-аккаунт Firebase Admin, закодированный в base64 (одной строкой).
# Получить: Firebase Console → Project settings → Service accounts →
# Generate new private key → скачается JSON-файл. Закодировать:
#   base64 -w 0 serviceAccountKey.json    (Linux)
#   base64 -i serviceAccountKey.json      (macOS)
# Результат — в переменную ниже. Файл serviceAccountKey.json после
# этого в git НЕ класть и на диске не оставлять лишний раз.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Список разрешённых e-mail через запятую, без пробелов (Google-аккаунты
# тестеров). Пусто = доступ открыт любому с валидным Firebase-токеном
# (не для прода).
ALLOWED_EMAILS=

# === Опционально ===
# Какую модель Gemini использовать. По умолчанию gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash

# Порт (Railway сам подставит свой через process.env.PORT — это только для локального теста)
PORT=8080

# Ключ Google Maps / Geocoding — понадобится, когда будем выносить и его
# (маршрутный калькулятор и голосовой поиск мест сейчас бьют в Maps API напрямую из приложения)
GOOGLE_MAPS_API_KEY=
